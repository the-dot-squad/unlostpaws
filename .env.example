# ============================================================================
# UnLostPaws — Environment Configuration
# ============================================================================
# Copy this file to .env.local and fill in the required values.
#
#   cp .env.example .env.local
#
# Variables marked [REQUIRED] must be set for the app to start.
# Variables marked [PRODUCTION] must be changed from dev defaults before deploy.
# Variables marked [OPTIONAL] have sensible defaults and can be omitted.
# ============================================================================


# ──────────────────────────────────────────────────────────────────────────────
# Database                                                          [REQUIRED]
# ──────────────────────────────────────────────────────────────────────────────
# MongoDB connection string. Supports replica sets and SRV records.
# The database must have geospatial indexes enabled (auto-created by Mongoose).
DATABASE_URL=mongodb://127.0.0.1:27017/unlostpaws


# ──────────────────────────────────────────────────────────────────────────────
# Application URL                                                   [REQUIRED]
# ──────────────────────────────────────────────────────────────────────────────
# Public-facing base URL (no trailing slash). Used for:
#   - OAuth callback redirects
#   - Webhook callback URLs sent to the ML worker
#   - Origin validation for CSRF protection
#   - Email links and sitemap generation
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public-facing GitHub repository URL (no trailing slash). Used for:
#   - Header navbar repository link and stars indicator.
NEXT_PUBLIC_GITHUB_REPO=https://github.com/the-dot-squad/unlostpaws



# ──────────────────────────────────────────────────────────────────────────────
# Authentication & Security                                      [PRODUCTION]
# ──────────────────────────────────────────────────────────────────────────────
# better-auth session encryption secret.
# PRODUCTION: Must be ≥32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=dev-secret-change-in-production-min-32-chars

# Salt for encoding internal MongoDB ObjectIds into public-facing IDs.
# PRODUCTION: Must be changed from the dev default to prevent ID enumeration.
PUBLIC_ID_SALT=dev-public-id-salt-change-in-production


# ──────────────────────────────────────────────────────────────────────────────
# OAuth Providers                                                   [OPTIONAL]
# ──────────────────────────────────────────────────────────────────────────────
# Configure at least one OAuth provider for user sign-in.
# Create credentials at each provider's developer console.

# Google OAuth 2.0 — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Login — https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Twitter/X OAuth 2.0 — https://developer.twitter.com/en/portal/dashboard
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=


# ──────────────────────────────────────────────────────────────────────────────
# Upstash Redis                                                     [REQUIRED]
# ──────────────────────────────────────────────────────────────────────────────
# Upstash Redis REST connection details. Used for:
#   - ML image processing job queue (Redis Streams)
#   - IP-based rate limiting (sliding window counters)
#
# Obtain REST URL and Token from your Upstash console.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here


# ──────────────────────────────────────────────────────────────────────────────
# ML Pipeline — Vision Worker Integration                        [PRODUCTION]
# ──────────────────────────────────────────────────────────────────────────────
# Shared secret between the Next.js app and the Python vision worker.
# The worker authenticates webhook callbacks using this token.
# Supported auth methods: Authorization: Bearer, x-api-key header, ?token= query.
# PRODUCTION: Must be changed from the dev default.
WEBHOOK_SECRET=dev-webhook-secret


# ──────────────────────────────────────────────────────────────────────────────
# Qdrant Vector Database                                            [REQUIRED]
# ──────────────────────────────────────────────────────────────────────────────
# Qdrant Cloud instance for SigLIP2 embedding similarity search.
# Collections (listing_images, owned_pets) and payload indexes are
# auto-created on first access — see README for full schema reference.

# Qdrant Cloud cluster URL (e.g. https://xxxx.eu-central.aws.cloud.qdrant.io:6333)
QDRANT_URL=

# Qdrant API key from the Qdrant Cloud dashboard
QDRANT_API_KEY=

# Embedding vector dimensions — must match the ML model output.         [OPTIONAL]
# Default: 768 (SigLIP2 base). Change only if using a different model.
# QDRANT_VECTOR_SIZE=768

# Enable int8 scalar quantization for reduced memory footprint.        [OPTIONAL]
# Trades ~1% accuracy for ~4× memory savings on large collections.
# QDRANT_SCALAR_QUANTIZATION=false


# ──────────────────────────────────────────────────────────────────────────────
# Cron Jobs                                                      [PRODUCTION]
# ──────────────────────────────────────────────────────────────────────────────
# Bearer token for authenticating scheduled cron endpoints:
#   - /api/cron/cleanup-uploads     (orphan media purge)
#   - /api/cron/expire-listings     (listing lifecycle expiry)
#   - /api/cron/match-missing-listings (failed job reconciliation)
# PRODUCTION: Must be changed from the dev default.
CRON_SECRET=dev-cron-secret


# ──────────────────────────────────────────────────────────────────────────────
# Object Storage (S3 / Cloudflare R2)                               [OPTIONAL]
# ──────────────────────────────────────────────────────────────────────────────
# In development, images are stored locally in public/uploads/.
# For production, set STORAGE_MODE=s3 and configure all S3_* variables.
#
# Supported providers: AWS S3, Cloudflare R2, MinIO, or any S3-compatible API.

# Storage backend: "local" (default in dev) or "s3" (production).
# If omitted, auto-detects based on whether S3 credentials are fully set.
# STORAGE_MODE=local

# S3-compatible endpoint URL (no trailing slash, no bucket name).
# Examples:
#   AWS:          https://s3.us-east-1.amazonaws.com
#   Cloudflare:   https://<account-id>.r2.cloudflarestorage.com
#   MinIO:        http://localhost:9000
# S3_ENDPOINT=

# S3 access credentials
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Bucket name (created in your S3/R2 dashboard)
# S3_BUCKET=unlostpaws

# Public CDN URL for serving uploaded images to browsers (no trailing slash).
# For R2: use the public bucket URL or a custom domain.
# S3_PUBLIC_URL=https://cdn.unlostpaws.com

# AWS region identifier. Use "auto" for Cloudflare R2.
# S3_REGION=auto

# Force path-style URLs (bucket in path instead of subdomain).              [OPTIONAL]
# Default: true. Set to "false" only for AWS S3 virtual-hosted-style access.
# S3_FORCE_PATH_STYLE=true


# ──────────────────────────────────────────────────────────────────────────────
# Cloudflare Turnstile (Bot Protection)                             [OPTIONAL]
# ──────────────────────────────────────────────────────────────────────────────
# CAPTCHA widget for listing submission and contact forms.
# Get keys at: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# ──────────────────────────────────────────────────────────────────────────────
# Email                                                             [OPTIONAL]
# ──────────────────────────────────────────────────────────────────────────────
# Transactional email for notifications and verification.
# Supported providers: mailtrap (default), mailjet, zeptomail.

# Which email provider to use
EMAIL_PROVIDER=mailtrap

# Sender address shown in outgoing emails
EMAIL_FROM=noreply@unlostpaws.com

# --- Mailtrap (default for dev) --- https://mailtrap.io
MAILTRAP_TOKEN=
MAILTRAP_SANDBOX_ID=
# Optional override (defaults to sandbox.api.mailtrap.io)
# MAILTRAP_API_ORIGIN=

# --- Mailjet --- https://app.mailjet.com/account/apikeys
# MAILJET_API_KEY=
# MAILJET_API_SECRET=
# Optional override (defaults to api.mailjet.com/v3.1/send)
# MAILJET_API_ORIGIN=

# --- ZeptoMail --- https://zeptomail.zoho.com
# ZEPTOMAIL_TOKEN=
# Optional override (defaults to api.zeptomail.com/v1.1/email)
# ZEPTOMAIL_API_ORIGIN=


# ──────────────────────────────────────────────────────────────────────────────
# Analytics                                                         [OPTIONAL]
# ──────────────────────────────────────────────────────────────────────────────
# Google Tag Manager container ID (e.g. GTM-XXXXXXX).
# Leave empty to disable analytics tracking.
NEXT_PUBLIC_GTM_ID=


# ──────────────────────────────────────────────────────────────────────────────
# CMS Content API                                                   [OPTIONAL]
# ──────────────────────────────────────────────────────────────────────────────
# External content management integration for dynamic pages/blog.

# Base URL for the content API
# DGCONTENT_API_BASE_URL=https://dgtteam-content.vercel.app/api

# API key and website identifier for authenticated requests
# DGCONTENT_API_KEY=
# DGCONTENT_WEBSITE_KEY=


# ──────────────────────────────────────────────────────────────────────────────
# Telegram Channel                                                  [OPTIONAL]
# ──────────────────────────────────────────────────────────────────────────────
# Auto-post missing and surrender alerts to a Telegram channel after ML
# processing. Both values are required to enable posting; leave empty to disable.
# The bot must be a channel admin with permission to post messages.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=              # @channelusername or -100xxxxxxxxxx


# ──────────────────────────────────────────────────────────────────────────────
# Geocoding & Contact                                               [OPTIONAL]
# ──────────────────────────────────────────────────────────────────────────────
# Nominatim (OpenStreetMap) requires a contact email for its usage policy.
# Also used as fallback for the platform's contact inbox.
NOMINATIM_CONTACT_EMAIL=support@unlostpaws.com
CONTACT_INBOX_EMAIL=support@unlostpaws.com


# ──────────────────────────────────────────────────────────────────────────────
# Rate Limiting                                                     [OPTIONAL]
# ──────────────────────────────────────────────────────────────────────────────
# IP-based rate limiting for API routes. Uses Redis when available,
# falls back to in-memory counters in development.

# Master toggle — set to "false" to disable all IP rate limiting.
# RATE_LIMIT_ENABLED=true

# Max general API requests per IP within the sliding window.
# RATE_LIMIT_MAX_REQUESTS=200

# Sliding window duration in seconds.
# RATE_LIMIT_WINDOW_SECONDS=60

# Max presigned upload requests per IP within the sliding window.
# RATE_LIMIT_UPLOAD_MAX_REQUESTS=40

# In development, use in-memory counters instead of requiring Redis.
# Set to "false" to force Redis even in dev mode.
# RATE_LIMIT_DEV_MEMORY=true
